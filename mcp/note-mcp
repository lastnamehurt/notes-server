#!/usr/bin/env python3
"""note-mcp - expose the notes repo to an AI tool over MCP: save, search, get, update, delete, list, sync.

Speaks MCP over stdio (newline-delimited JSON-RPC) using only the standard library,
so it runs on any machine that has python3. Configure an MCP client to launch
this executable with NOTES_DIR pointing at your local notes clone.

The tool surface provides search/get/update/delete, confirmation for destructive calls,
and descriptions that say when to use each. The store is the personal ~/notes repo.
A note id is its path
relative to the repo, such as inbox/2026-10-09-kafka-retries.md.

Writes are commits, so installed Git hooks still guard them, and git history is
the undo. NOTES_DIR overrides the repo; NOTE_BIN overrides the `note` command (tests).
"""
import difflib
import json
import os
import re
import subprocess
import sys

NOTES_DIR = os.environ.get("NOTES_DIR") or os.path.expanduser("~/notes")
HERE = os.path.dirname(os.path.abspath(__file__))
NOTE_BIN = os.environ.get("NOTE_BIN") or os.path.join(HERE, "..", "bin", "note")
FOLDERS = ("inbox", "goals", "projects", "decisions", "runbooks", "reference", "journal")
MAX_RESULTS = 10
MAX_DIFF_LINES = 60


