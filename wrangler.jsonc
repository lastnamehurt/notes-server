{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-notes-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // No id: Wrangler reuses the namespace already bound to a deployed Worker, or creates one on a first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "durable_objects": {
    "bindings": [{ "name": "REMINDERS", "class_name": "ReminderScheduler" }]
  },
  "migrations": [{ "tag": "v1-reminders", "new_sqlite_classes": ["ReminderScheduler"] }],
  "triggers": { "crons": ["7 * * * *"] },
  // Per-owner settings (NOTES_REPO, NOTES_TIMEZONE, PUBLIC_URL, push keys) live in Cloudflare, not in this file,
  // so one copy of the code serves every owner. keep_vars stops deploys from wiping ones set as dashboard variables.
  "keep_vars": true
}
