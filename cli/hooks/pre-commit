#!/usr/bin/env bash
# Block commits that add likely secrets or sensitive PII. Bypass (rarely) with --no-verify.
set -uo pipefail

patterns=(
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'AKIA[0-9A-Z]{16}'
  'glpat-[A-Za-z0-9_-]{20,}'
  'sk-ant-[A-Za-z0-9_-]{20,}'
  'xox[abprs]-[A-Za-z0-9-]{10,}'
  '(ghp|gho|ghs)_[A-Za-z0-9]{30,}'
  '(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*["'\'']?[A-Za-z0-9/+_-]{12,}'
  '\b[0-9]{3}-[0-9]{2}-[0-9]{4}\b'
)

added="$(git diff --cached -U0 --diff-filter=AM | grep -E '^\+' | grep -vE '^\+\+\+')"
status=0
for p in "${patterns[@]}"; do
  if hits="$(printf '%s\n' "$added" | grep -E -- "$p")"; then
    echo "pre-commit: possible secret/PII matching /$p/" >&2
    printf '%s\n' "$hits" | head -3 | cut -c1-100 | sed 's/^/    /' >&2
    status=1
  fi
done

if [[ $status -ne 0 ]]; then
  echo "pre-commit: commit blocked. Remove it, or use --no-verify if this is a false positive." >&2
fi
exit $status
